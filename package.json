{
  "name": "easymirror",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:spike": "wxt build --mode spike",
    "postinstall": "wxt prepare",
    "spike:server": "node spikes/server.mjs",
    "spike:run": "node spikes/run-spikes.mjs",
    "test": "vitest run",
    "test:e2e": "wxt build --mode spike && node tests/e2e/e2e.mjs",
    "icons": "node scripts/make-icons.mjs",
    "store-images": "wxt build && node scripts/store-screenshots.mjs",
    "zip": "wxt zip && wxt zip -b firefox",
    "real-upload": "wxt build && node scripts/real-upload.mjs"
  },
  "devDependencies": {
    "busboy": "1.6.0",
    "playwright": "1.64.1",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5",
    "wxt": "0.21.4"
  }
}
